#!/bin/bash
# Starts everything needed for local dev: db, migrations, poll loop, tunnel, server.
# Safe to re-run ... docker compose and migrate are both idempotent.
set -e

# resolve paths relative to this script, not wherever it was invoked from
cd "$(dirname "$0")"

# activate the virtual environment
source venv/bin/activate

# start (or reuse) the local Postgres container
docker compose up -d db

# run migrations
python manage.py migrate

# run background polling loop
python manage.py poll_seats &
POLL_PID=$!

# named Cloudflare Tunnel, forwards Telnyx's webhook
# to localhost:8000 (development machine must have ~/.cloudflared/config.yml configured
# to route hostname to localhost port 8000)
cloudflared tunnel run &
TUNNEL_PID=$!

# kill both background processes when this script exits, so Ctrl+C doesn't
# leave an orphaned poll loop or tunnel running
trap "kill $POLL_PID $TUNNEL_PID 2>/dev/null" EXIT

python manage.py runserver
