# Copy to .env and fill in. All vars are required — see CAB_Utils/settings.py.

SECRET_KEY=              # python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=true
# used for django allowed hosts. needs to be set to the app's public url
ALLOWED_HOSTS=localhost,127.0.0.1

# Read by both Django (settings.py) and docker-compose.yml, so local Postgres
# and the app agree without duplicating config.
POSTGRES_DB=cab_utils
POSTGRES_USER=cab_utils
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# AES-256-SIV key for core.fields.EncryptedPhoneField — must decode to exactly
# 64 bytes. Generate with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(64)).decode())"
PHONE_ENCRYPTION_KEY=

# Max active SeatSignal watches per user (abuse/cost guardrail).
SIGNAL_CAP=5

# Telnyx - required by the app itself (sms/views.py, sms/telnyx_client.py),
# also used standalone by sms/scripts/ for connectivity checks.
TELNYX_API_KEY=              # Telnyx portal -> API Keys
TELNYX_PUBLIC_KEY=           # Telnyx portal -> Public Key, verifies inbound webhook signatures
TELNYX_PHONE_NUMBER=         # the purchased number, E.164, e.g. +18025551234
TELNYX_TEST_RECIPIENT=       # your own phone, E.164 - send_ping.py texts this number

# Public URL that routes to /sms/webhook/ (your Cloudflare tunnel hostname, or
# whatever's fronting the app) - set as this Messaging Profile's inbound
# webhook URL in the Telnyx portal. Only printed for reference by
# sms/scripts/listen_for_sms.py, not used by the app itself.
TELNYX_INBOUND_WEBHOOK_URL=

# Terms & Privacy page linked in the SMS opt-in message (sms/conversation.py).
PRIVACY_URL=
